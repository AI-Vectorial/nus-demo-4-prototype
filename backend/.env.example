# Copy to .env for local work. In a Codespace these are already in your
# environment -- you should not need this file at all.
#
# NEVER commit .env. NEVER paste a key into any other file.

# --- OpenRouter: the only model credential ---------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# --- Embeddings -------------------------------------------------------------
# D0 (table 3): text-embedding-3-large, 3072. Small did not separate the
# evaluation questions; large does -- docs/design/D0-embedding-model.md. The
# Qdrant collection is created at this dimension; changing it means --force.
EMBEDDING_MODEL_SLUG=openai/text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
EMBEDDING_BATCH_SIZE=96

# --- Postgres ---------------------------------------------------------------
# Set for you on the deployed service. DATABASE_NAME is what keeps your data
# separate from the other four tables -- do not change it.
DATABASE_URL=postgresql://localhost:5432/policy
DATABASE_NAME=

# --- Qdrant -----------------------------------------------------------------
# QDRANT_COLLECTION is set for you, and is likewise yours alone.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=policy_passages

# --- Your decisions ---------------------------------------------------------
# Table 3's answers. Each is recorded, with the team's reason, in docs/design/.

# D2 -- the midpoint of the measured gap on the large model (Q3 0.524, Q11
# 0.446), signed off by the team. Re-measure if D0 or D1 change.
MIN_SCORE=0.485
# D1 -- one passage per section; 400 is a ceiling above the largest section.
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=0
# D3 -- a ceiling, not a citation count.
RETRIEVE_TOP_K=5

# D8 -- the last 5 MESSAGES (rows), not turns. D9 -- the user questions inside
# that window are what retrieval runs on. Retrieval runs on every turn.
CONTEXT_MESSAGES=5

# Turning this off must leave a working policy search behind, not a broken app.
GENERATION_ENABLED=true

# --- App --------------------------------------------------------------------
API_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000
