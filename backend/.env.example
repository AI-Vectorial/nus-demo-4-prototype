# Copy to .env for local work. In a Codespace these are already in your
# environment -- you should not need this file at all.
#
# NEVER commit .env. NEVER paste a key into any other file.

# --- OpenRouter: the only model credential ---------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# --- Embeddings -------------------------------------------------------------
# YOUR DECISION (PRD section 9, D0). The Qdrant collection is created at
# whatever dimension you first index with, so these two must agree. Changing
# the model later means re-indexing with --force.
#
#   openai/text-embedding-3-small   1536   cheaper
#   openai/text-embedding-3-large   3072   better, slower, costs more
EMBEDDING_MODEL_SLUG=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=96

# --- Postgres ---------------------------------------------------------------
# Set for you on the deployed service. DATABASE_NAME is what keeps your data
# separate from the other four tables -- do not change it.
DATABASE_URL=postgresql://localhost:5432/policy
DATABASE_NAME=

# --- Qdrant -----------------------------------------------------------------
# QDRANT_COLLECTION is set for you, and is likewise yours alone.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=policy_passages

# --- Your decisions ---------------------------------------------------------
# Table 3's answers to PRD section 10, with the reasons: docs/design/decisions.md
# None has a default in code -- unset, the request that needs it fails loudly.
MIN_SCORE=0.51
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
RETRIEVE_TOP_K=6

# How many recent turns a follow-up question is answered with (D8).
# Retrieval still runs on every turn -- context informs the answer, it never
# replaces the search. See PRD REQ-C5.
CONTEXT_MESSAGES=5

# Turning this off must leave a working policy search behind, not a broken app.
GENERATION_ENABLED=true

# --- App --------------------------------------------------------------------
API_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000
