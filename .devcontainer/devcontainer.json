{
  "name": "M04 Policy Assistant",
  // Compose rather than a bare Dockerfile, so Postgres and Qdrant come up
  // beside the workspace. A table can then run ingestion and see retrieval
  // work without deploying first.
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/nus-demo-4-prototype",

  // Both services start automatically. An agent edit is visible on refresh in
  // about two seconds -- that loop is what makes the feature feel like theirs.
  // Frontend deps, and the credential selection wired into every shell --
  // not only the one that starts the servers.
  "postCreateCommand": "cd frontend && npm install; grep -q credentials.sh ~/.bashrc || echo '. ${containerWorkspaceFolder}/.devcontainer/credentials.sh' >> ~/.bashrc; bash ${containerWorkspaceFolder}/.devcontainer/limit-refs.sh || true",
  "postAttachCommand": "bash .devcontainer/start.sh",

  // The GitHub CLI, explicitly. Stage 05 has the agent open the pull request
  // with `gh pr create`, and the base python image does not carry gh -- an
  // agent discovering that at minute 125 has nowhere to go, because the one
  // thing it needs is the thing it cannot install without the network it is
  // about to use.
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": {
      "label": "Policy Assistant (your branch)",
      // notify, not openPreview. A port is forwarded the moment the socket is
      // bound, and `next dev` binds before it has compiled anything -- so
      // openPreview reliably opened a dead page on first attach and said
      // "connection failed". A notification waits for a human to click it, by
      // which time start.sh has polled the server and reported it ready.
      "onAutoForward": "notify",
      // public, not org. An org-scoped forward needs a GitHub auth cookie the
      // proxy cannot always get -- it returned 502 in both Brave and Chrome
      // during the dry run, which reads as a broken app rather than a blocked
      // one. The URL is unguessable, the data is fictional, and the service
      // lives for one afternoon.
      "visibility": "public"
    },
    "8000": {
      "label": "API",
      "onAutoForward": "silent",
      "visibility": "public"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],
      // The first thing a table should see is the page telling them where to
      // start, not an empty editor.
      "openFiles": ["START-HERE.md"],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        // Selecting text in the terminal copies it. A table spends the whole
        // session reading an agent's output in a terminal and pasting bits of
        // it back -- and the default there is that Ctrl+C with no selection
        // sends an interrupt and says "no selection to copy", which is both
        // confusing and, mid-build, destructive.
        "terminal.integrated.copyOnSelection": true,
        // Right-click pastes rather than opening a menu, so the round trip out
        // of the terminal and back is two actions instead of four.
        "terminal.integrated.rightClickBehavior": "paste",
        // The agent prints tables and score reports that wrap badly at the
        // default, and a wrapped score table is unreadable exactly when it
        // matters.
        "terminal.integrated.scrollback": 20000,
        "python.testing.pytestEnabled": true,
        "python.testing.cwd": "${workspaceFolder}/backend"
      }
    }
  },

  // Everything else -- the stores, the API key -- comes from docker-compose
  // and from the repository's Codespaces secrets. A table configures nothing.
  "remoteEnv": {
    "API_URL": "http://127.0.0.1:8000"
  }
}
